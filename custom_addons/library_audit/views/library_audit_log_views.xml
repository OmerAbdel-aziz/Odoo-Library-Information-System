<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_audit_log_view_list" model="ir.ui.view">
        <field name="name">library.audit.log.list</field>
        <field name="model">library.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="0" edit="0">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="model_id"/>
                <field name="res_name"/>
                <field name="operation" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="library_audit_log_view_form" model="ir.ui.view">
        <field name="name">library.audit.log.form</field>
        <field name="model">library.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Record">
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="model_id"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                            <field name="operation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Changes" name="changes">
                            <field name="line_ids" readonly="1">
                                <list string="Changes" create="0" edit="0" delete="0">
                                    <field name="field_label"/>
                                    <field name="old_value"/>
                                    <field name="new_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_audit_log_view_search" model="ir.ui.view">
        <field name="name">library.audit.log.search</field>
        <field name="model">library.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit Log">
                <field name="res_name"/>
                <field name="user_id"/>
                <separator/>
                <filter name="create" string="Creates" domain="[('operation', '=', 'create')]"/>
                <filter name="write" string="Writes" domain="[('operation', '=', 'write')]"/>
                <filter name="unlink" string="Deletions" domain="[('operation', '=', 'unlink')]"/>
                <group>
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_operation" string="Operation" context="{'group_by': 'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_audit_log_action" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">library.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="library_audit_menu" name="Audit" parent="library_base.library_menu_configuration" sequence="90" groups="library_base.library_group_library_manager"/>
    <menuitem id="library_audit_log_menu" name="Audit Log" parent="library_audit_menu" action="library_audit_log_action" sequence="10"/>
    <menuitem id="library_audit_rule_menu" name="Audit Rules" parent="library_audit_menu" action="library_audit_rule_action" sequence="20"/>
</odoo>
