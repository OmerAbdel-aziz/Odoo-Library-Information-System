<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_audit_rule_view_list" model="ir.ui.view">
        <field name="name">library.audit.rule.list</field>
        <field name="model">library.audit.rule</field>
        <field name="arch" type="xml">
            <list string="Audit Rules">
                <field name="name"/>
                <field name="model_id"/>
                <field name="track_create" string="Create"/>
                <field name="track_write" string="Write"/>
                <field name="track_unlink" string="Delete"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="library_audit_rule_view_form" model="ir.ui.view">
        <field name="name">library.audit.rule.form</field>
        <field name="model">library.audit.rule</field>
        <field name="arch" type="xml">
            <form string="Audit Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Track book copies"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="active" invisible="1"/>
                            <field name="model_id"/>
                            <field name="field_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Operations">
                            <field name="track_create"/>
                            <field name="track_write"/>
                            <field name="track_unlink"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_audit_rule_action" model="ir.actions.act_window">
        <field name="name">Audit Rules</field>
        <field name="res_model">library.audit.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
