<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="library_digital_asset_company_rule" model="ir.rule">
            <field name="name">Library Digital Asset: multi-company</field>
            <field name="model_id" ref="model_library_digital_asset"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="library_digital_checkout_company_rule" model="ir.rule">
            <field name="name">Library Digital Checkout: multi-company</field>
            <field name="model_id" ref="model_library_digital_checkout"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="library_digital_asset_user_rule" model="ir.rule">
            <field name="name">Library Digital Asset: assigned branches</field>
            <field name="model_id" ref="model_library_digital_asset"/>
            <field name="domain_force">['|', ('branch_id', 'in', user.allowed_branch_ids.ids), ('branch_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>
        <record id="library_digital_checkout_user_rule" model="ir.rule">
            <field name="name">Library Digital Checkout: assigned branches</field>
            <field name="model_id" ref="model_library_digital_checkout"/>
            <field name="domain_force">['|', ('branch_id', 'in', user.allowed_branch_ids.ids), ('branch_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <record id="library_digital_asset_branch_manager_rule" model="ir.rule">
            <field name="name">Library Digital Asset: branch manager sees all</field>
            <field name="model_id" ref="model_library_digital_asset"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
        <record id="library_digital_checkout_branch_manager_rule" model="ir.rule">
            <field name="name">Library Digital Checkout: branch manager sees all</field>
            <field name="model_id" ref="model_library_digital_checkout"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
