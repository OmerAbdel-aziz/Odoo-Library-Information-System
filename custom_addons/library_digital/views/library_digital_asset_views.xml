<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_digital_asset_view_list" model="ir.ui.view">
        <field name="name">library.digital.asset.list</field>
        <field name="model">library.digital.asset</field>
        <field name="arch" type="xml">
            <list string="Digital Assets" multi_edit="1">
                <field name="name"/>
                <field name="title"/>
                <field name="asset_type" widget="badge"/>
                <field name="branch_id" optional="show"/>
                <field name="license_limit" string="Licenses" optional="show"/>
                <field name="active_checkout_count" string="In Use"/>
                <field name="expiry_date" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_digital_asset_view_form" model="ir.ui.view">
        <field name="name">library.digital.asset.form</field>
        <field name="model">library.digital.asset</field>
        <field name="arch" type="xml">
            <form string="Digital Asset">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_checkouts" type="object" class="oe_stat_button" icon="fa-download">
                            <field name="active_checkout_count" widget="statinfo" string="In Use"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Python Crash Course (E-Book)"/></h1>
                    </div>
                    <group>
                        <group string="Asset">
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="asset_type"/>
                            <field name="author"/>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="License">
                            <field name="access_mode"/>
                            <field name="allowed_plan_ids" invisible="access_mode != 'restricted'"/>
                            <field name="download_allowed"/>
                            <field name="license_limit"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="File">
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="About this asset..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_digital_asset_view_search" model="ir.ui.view">
        <field name="name">library.digital.asset.search</field>
        <field name="model">library.digital.asset</field>
        <field name="arch" type="xml">
            <search string="Digital Assets">
                <field name="name"/>
                <field name="title"/>
                <field name="author"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'asset_type'}"/>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_digital_asset_action" model="ir.actions.act_window">
        <field name="name">Digital Assets</field>
        <field name="res_model">library.digital.asset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a digital asset</p>
            <p>Upload e-books, audio books and research documents.</p>
        </field>
    </record>
</odoo>
