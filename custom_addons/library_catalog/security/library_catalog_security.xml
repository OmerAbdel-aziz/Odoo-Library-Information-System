<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rules -->
        <record id="library_book_company_rule" model="ir.rule">
            <field name="name">Library Book: multi-company</field>
            <field name="model_id" ref="model_library_book"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="library_book_copy_company_rule" model="ir.rule">
            <field name="name">Library Book Copy: multi-company</field>
            <field name="model_id" ref="model_library_book_copy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="library_author_company_rule" model="ir.rule">
            <field name="name">Library Author: multi-company</field>
            <field name="model_id" ref="model_library_author"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="library_publisher_company_rule" model="ir.rule">
            <field name="name">Library Publisher: multi-company</field>
            <field name="model_id" ref="model_library_publisher"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="library_subject_company_rule" model="ir.rule">
            <field name="name">Library Subject: multi-company</field>
            <field name="model_id" ref="model_library_subject"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="library_category_company_rule" model="ir.rule">
            <field name="name">Library Category: multi-company</field>
            <field name="model_id" ref="model_library_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="library_language_company_rule" model="ir.rule">
            <field name="name">Library Language: multi-company</field>
            <field name="model_id" ref="model_library_language"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="library_classification_system_company_rule" model="ir.rule">
            <field name="name">Library Classification System: multi-company</field>
            <field name="model_id" ref="model_library_classification_system"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="library_classification_code_company_rule" model="ir.rule">
            <field name="name">Library Classification Code: multi-company</field>
            <field name="model_id" ref="model_library_classification_code"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="library_series_company_rule" model="ir.rule">
            <field name="name">Library Series: multi-company</field>
            <field name="model_id" ref="model_library_series"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- User-level rules: branch visibility for copies -->
        <record id="library_book_copy_user_rule" model="ir.rule">
            <field name="name">Library Book Copy: assigned branches</field>
            <field name="model_id" ref="model_library_book_copy"/>
            <field name="domain_force">[('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>
        <record id="library_book_user_rule" model="ir.rule">
            <field name="name">Library Book: user rule</field>
            <field name="model_id" ref="model_library_book"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <!-- Branch Manager rules: see all -->
        <record id="library_book_copy_branch_manager_rule" model="ir.rule">
            <field name="name">Library Book Copy: branch manager sees all</field>
            <field name="model_id" ref="model_library_book_copy"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
