<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_book_copy_view_list" model="ir.ui.view">
        <field name="name">library.book.copy.list</field>
        <field name="model">library.book.copy</field>
        <field name="arch" type="xml">
            <list string="Book Copies" multi_edit="1">
                <field name="barcode"/>
                <field name="book_id"/>
                <field name="copy_number" optional="show"/>
                <field name="branch_id"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-warning="state == 'reserved'" decoration-info="state == 'on_loan'" decoration-danger="state in ('lost', 'damaged', 'withdrawn')"/>
                <field name="condition" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_book_copy_view_form" model="ir.ui.view">
        <field name="name">library.book.copy.form</field>
        <field name="model">library.book.copy</field>
        <field name="arch" type="xml">
            <form string="Book Copy">
                <header>
                    <button name="action_available" type="object" string="Mark Available" class="oe_highlight" invisible="state != 'available'"/>
                    <button name="action_on_loan" type="object" string="Mark On Loan" invisible="state != 'available'"/>
                    <button name="action_lost" type="object" string="Mark Lost" invisible="state in ('lost', 'withdrawn')"/>
                    <button name="action_withdrawn" type="object" string="Withdraw" invisible="state in ('lost', 'withdrawn')"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,on_loan"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Copy Details">
                            <field name="book_id"/>
                            <field name="copy_number"/>
                            <field name="barcode"/>
                            <field name="qr_code"/>
                            <field name="condition"/>
                        </group>
                        <group string="Location">
                            <field name="branch_id"/>
                            <field name="floor_id"/>
                            <field name="section_id"/>
                            <field name="shelf_id"/>
                        </group>
                    </group>
                    <group string="Acquisition">
                        <group>
                            <field name="acquisition_date"/>
                            <field name="acquisition_cost"/>
                            <field name="last_inventory_date"/>
                        </group>
                        <group>
                            <field name="reference_only"/>
                            <field name="circulating"/>
                            <field name="stock_lot_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_book_copy_view_search" model="ir.ui.view">
        <field name="name">library.book.copy.search</field>
        <field name="model">library.book.copy</field>
        <field name="arch" type="xml">
            <search string="Book Copies">
                <field name="barcode"/>
                <field name="book_id"/>
                <field name="branch_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="on_loan" string="On Loan" domain="[('state', '=', 'on_loan')]"/>
                <filter name="reserved" string="Reserved" domain="[('state', '=', 'reserved')]"/>
                <filter name="lost" string="Lost" domain="[('state', '=', 'lost')]"/>
                <separator/>
                <group>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_book" string="Book" context="{'group_by': 'book_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_book_copy_action" model="ir.actions.act_window">
        <field name="name">Book Copies</field>
        <field name="res_model">library.book.copy</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a book copy</p>
            <p>Register physical copies of books in the library.</p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="library_book_copy_menu" name="Book Copies" parent="library_base.library_menu_operations" action="library_book_copy_action" sequence="30" groups="library_base.library_group_user"/>
</odoo>
