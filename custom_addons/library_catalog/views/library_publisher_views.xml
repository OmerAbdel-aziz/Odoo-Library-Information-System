<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_publisher_view_list" model="ir.ui.view">
        <field name="name">library.publisher.list</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <list string="Publishers" multi_edit="1">
                <field name="name"/>
                <field name="country_id"/>
                <field name="website" optional="show"/>
                <field name="book_count" string="Books"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_publisher_view_form" model="ir.ui.view">
        <field name="name">library.publisher.form</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <form string="Publisher">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_books" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="book_count" widget="statinfo" string="Books"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Prentice Hall"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="active" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="country_id"/>
                            <field name="website"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_publisher_view_search" model="ir.ui.view">
        <field name="name">library.publisher.search</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <search string="Publishers">
                <field name="name"/>
                <field name="country_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_publisher_action" model="ir.actions.act_window">
        <field name="name">Publishers</field>
        <field name="res_model">library.publisher</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a publisher</p>
        </field>
    </record>
</odoo>
