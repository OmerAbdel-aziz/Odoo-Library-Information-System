<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_category_view_list" model="ir.ui.view">
        <field name="name">library.category.list</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <list string="Categories" multi_edit="1">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="book_count" string="Books"/>
            </list>
        </field>
    </record>

    <record id="library_category_view_form" model="ir.ui.view">
        <field name="name">library.category.form</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_books" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="book_count" widget="statinfo" string="Books"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Fiction"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. FIC"/>
                            <field name="parent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_category_view_kanban" model="ir.ui.view">
        <field name="name">library.category.kanban</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="book_count"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div>
                            <field name="book_count"/> Books
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="library_category_view_search" model="ir.ui.view">
        <field name="name">library.category.search</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <search string="Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>

    <record id="library_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">library.category</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a category</p>
        </field>
    </record>
</odoo>
