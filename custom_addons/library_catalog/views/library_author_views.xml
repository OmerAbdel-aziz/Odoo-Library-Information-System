<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_author_view_list" model="ir.ui.view">
        <field name="name">library.author.list</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list string="Authors" multi_edit="1">
                <field name="name"/>
                <field name="country_id"/>
                <field name="birth_date" optional="show"/>
                <field name="book_count" string="Books"/>
            </list>
        </field>
    </record>

    <record id="library_author_view_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_books" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="book_count" widget="statinfo" string="Books"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Robert C. Martin"/></h1>
                    </div>
                    <group>
                        <group string="Biography">
                            <field name="birth_date"/>
                            <field name="death_date"/>
                            <field name="country_id"/>
                            <field name="website"/>
                        </group>
                    </group>
                    <group string="Biography">
                        <field name="biography" placeholder="Author biography..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_author_view_search" model="ir.ui.view">
        <field name="name">library.author.search</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <search string="Authors">
                <field name="name"/>
                <field name="country_id"/>
                <group>
                    <filter name="group_by_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_author_action" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an author</p>
        </field>
    </record>
</odoo>
