<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_purchase_request_view_list" model="ir.ui.view">
        <field name="name">library.purchase.request.list</field>
        <field name="model">library.purchase.request</field>
        <field name="arch" type="xml">
            <list string="Purchase Requests" multi_edit="1">
                <field name="name"/>
                <field name="book_name"/>
                <field name="member_id" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="quantity"/>
                <field name="estimated_cost" widget="monetary" optional="show"/>
                <field name="request_date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('approved', 'ordered')" decoration-warning="state in ('submitted', 'received')" decoration-muted="state == 'cancelled'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_purchase_request_view_form" model="ir.ui.view">
        <field name="name">library.purchase.request.form</field>
        <field name="model">library.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_create_po" type="object" string="Create PO" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_receive" type="object" string="Receive" class="oe_highlight" invisible="state != 'ordered'"/>
                    <button name="action_catalog" type="object" string="Catalog" class="oe_highlight" invisible="state != 'received'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,ordered,received,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="active" invisible="1"/>
                            <field name="book_name"/>
                            <field name="author"/>
                            <field name="isbn"/>
                            <field name="quantity"/>
                            <field name="estimated_cost"/>
                            <field name="member_id"/>
                            <field name="requested_by"/>
                            <field name="approved_by"/>
                        </group>
                        <group string="Fulfillment">
                            <field name="branch_id"/>
                            <field name="shelf_id"/>
                            <field name="vendor_id"/>
                            <field name="purchase_order_id"/>
                            <field name="book_id"/>
                            <field name="request_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" placeholder="Why is this book needed..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_purchase_request_view_search" model="ir.ui.view">
        <field name="name">library.purchase.request.search</field>
        <field name="model">library.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Purchase Requests">
                <field name="name"/>
                <field name="book_name"/>
                <field name="member_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="ordered" string="Ordered" domain="[('state', '=', 'ordered')]"/>
                <filter name="done" string="Cataloged" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_purchase_request_action" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">library.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a purchase request</p>
            <p>Request new books for the library collection.</p>
        </field>
    </record>

    <menuitem id="library_acquisition_menu" name="Acquisition" parent="library_base.library_menu_operations" sequence="35" groups="library_base.library_group_acquisition"/>
    <menuitem id="library_purchase_request_menu" name="Purchase Requests" parent="library_acquisition_menu" action="library_purchase_request_action" sequence="10"/>
</odoo>
