<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="library_purchase_request_company_rule" model="ir.rule">
            <field name="name">Library Purchase Request: multi-company</field>
            <field name="model_id" ref="model_library_purchase_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="library_purchase_request_user_rule" model="ir.rule">
            <field name="name">Library Purchase Request: assigned branches</field>
            <field name="model_id" ref="model_library_purchase_request"/>
            <field name="domain_force">[('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <record id="library_purchase_request_branch_manager_rule" model="ir.rule">
            <field name="name">Library Purchase Request: branch manager sees all</field>
            <field name="model_id" ref="model_library_purchase_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
