<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_notification_view_list" model="ir.ui.view">
        <field name="name">library.notification.list</field>
        <field name="model">library.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications">
                <field name="name"/>
                <field name="member_id"/>
                <field name="notification_type" widget="badge"/>
                <field name="channel" optional="show"/>
                <field name="scheduled_date" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-warning="state == 'pending'" decoration-danger="state == 'failed'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_notification_view_form" model="ir.ui.view">
        <field name="name">library.notification.form</field>
        <field name="model">library.notification</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_send" type="object" string="Send Now" class="oe_highlight" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1><field name="subject" readonly="state != 'pending'"/></h1>
                    </div>
                    <group>
                        <group string="Notification">
                            <field name="active" invisible="1"/>
                            <field name="name" readonly="state != 'pending'"/>
                            <field name="member_id" readonly="state != 'pending'"/>
                            <field name="notification_type" readonly="state != 'pending'"/>
                            <field name="channel" readonly="state != 'pending'"/>
                            <field name="reference" readonly="state != 'pending'"/>
                        </group>
                        <group string="Delivery">
                            <field name="scheduled_date"/>
                            <field name="sent_date"/>
                            <field name="failure_reason"/>
                            <field name="branch_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" readonly="state != 'pending'"/>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_notification_view_search" model="ir.ui.view">
        <field name="name">library.notification.search</field>
        <field name="model">library.notification</field>
        <field name="arch" type="xml">
            <search string="Notifications">
                <field name="name"/>
                <field name="member_id"/>
                <separator/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'notification_type'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_notification_action" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">library.notification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <menuitem id="library_notifications_menu" name="Notifications" parent="library_base.library_menu_operations" sequence="70" groups="library_base.library_group_librarian"/>
    <menuitem id="library_notification_menu" name="Notifications" parent="library_notifications_menu" action="library_notification_action" sequence="10"/>
</odoo>
