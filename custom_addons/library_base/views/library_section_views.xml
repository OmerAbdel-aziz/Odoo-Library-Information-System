<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_section_view_list" model="ir.ui.view">
        <field name="name">library.section.list</field>
        <field name="model">library.section</field>
        <field name="arch" type="xml">
            <list string="Library Sections" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="section_type"/>
                <field name="branch_id"/>
                <field name="floor_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_section_view_form" model="ir.ui.view">
        <field name="name">library.section.form</field>
        <field name="model">library.section</field>
        <field name="arch" type="xml">
            <form string="Library Section">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Computer Science"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="code" placeholder="e.g. CS"/>
                            <field name="sequence"/>
                            <field name="section_type"/>
                            <field name="floor_id"/>
                            <field name="branch_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shelves" name="shelves">
                            <field name="shelf_ids" context="{'default_section_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_section_view_search" model="ir.ui.view">
        <field name="name">library.section.search</field>
        <field name="model">library.section</field>
        <field name="arch" type="xml">
            <search string="Library Sections">
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="floor_id"/>
                <field name="section_type"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_floor" string="Floor" context="{'group_by': 'floor_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'section_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_section_action" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">library.section</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_branch': 1}</field>
    </record>

    <menuitem id="library_section_menu" name="Sections" parent="library_menu_locations" action="library_section_action" sequence="30" groups="library_group_branch_manager"/>
</odoo>
