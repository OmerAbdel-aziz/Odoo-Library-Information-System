<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_library_base" model="ir.ui.view">
        <field name="name">res.users.form.library.base</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group" position="after">
                <group string="Library Access" groups="library_base.library_group_administrator,base.group_system">
                    <field name="allowed_branch_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
