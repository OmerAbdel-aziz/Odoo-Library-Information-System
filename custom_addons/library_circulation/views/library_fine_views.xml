<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_fine_view_list" model="ir.ui.view">
        <field name="name">library.fine.list</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <list string="Fines" multi_edit="1">
                <field name="name"/>
                <field name="member_id"/>
                <field name="fine_type" widget="badge"/>
                <field name="amount" widget="monetary"/>
                <field name="paid_amount" widget="monetary"/>
                <field name="remaining_amount" widget="monetary"/>
                <field name="due_date"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state == 'pending'" decoration-danger="state == 'cancelled'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_fine_view_form" model="ir.ui.view">
        <field name="name">library.fine.form</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <form string="Fine">
                <header>
                    <button name="action_pay" type="object" string="Mark as Paid" class="oe_highlight" invisible="state not in ('draft', 'pending')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_set_draft" type="object" string="Set to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Fine Details">
                            <field name="active" invisible="1"/>
                            <field name="member_id"/>
                            <field name="fine_type"/>
                            <field name="loan_id"/>
                            <field name="branch_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="amount"/>
                            <field name="paid_amount"/>
                            <field name="remaining_amount"/>
                            <field name="due_date"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Reason for fine..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_fine_view_search" model="ir.ui.view">
        <field name="name">library.fine.search</field>
        <field name="model">library.fine</field>
        <field name="arch" type="xml">
            <search string="Fines">
                <field name="name"/>
                <field name="member_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="late_return" string="Late Return" domain="[('fine_type', '=', 'late_return')]"/>
                <filter name="lost_book" string="Lost Book" domain="[('fine_type', '=', 'lost_book')]"/>
                <filter name="damaged_book" string="Damaged Book" domain="[('fine_type', '=', 'damaged_book')]"/>
                <group>
                    <filter name="group_by_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_by_type" string="Fine Type" context="{'group_by': 'fine_type'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_fine_action" model="ir.actions.act_window">
        <field name="name">Fines</field>
        <field name="res_model">library.fine</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fines found</p>
            <p>Fines are automatically generated for overdue book returns.</p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="library_circulation_menu" name="Circulation" parent="library_base.library_menu_operations" sequence="20" groups="library_base.library_group_circulation"/>
    <menuitem id="library_loan_menu" name="Loans" parent="library_circulation_menu" action="library_loan_action" sequence="10"/>
    <menuitem id="library_fine_menu" name="Fines" parent="library_circulation_menu" action="library_fine_action" sequence="20"/>
</odoo>
