<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rules -->
        <record id="library_loan_company_rule" model="ir.rule">
            <field name="name">Library Loan: multi-company</field>
            <field name="model_id" ref="model_library_loan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="library_loan_line_company_rule" model="ir.rule">
            <field name="name">Library Loan Line: multi-company</field>
            <field name="model_id" ref="model_library_loan_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="library_fine_company_rule" model="ir.rule">
            <field name="name">Library Fine: multi-company</field>
            <field name="model_id" ref="model_library_fine"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- User rules: branch visibility -->
        <record id="library_loan_user_rule" model="ir.rule">
            <field name="name">Library Loan: assigned branches</field>
            <field name="model_id" ref="model_library_loan"/>
            <field name="domain_force">[('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>
        <record id="library_loan_line_user_rule" model="ir.rule">
            <field name="name">Library Loan Line: assigned branches</field>
            <field name="model_id" ref="model_library_loan_line"/>
            <field name="domain_force">[('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>
        <record id="library_fine_user_rule" model="ir.rule">
            <field name="name">Library Fine: assigned branches</field>
            <field name="model_id" ref="model_library_fine"/>
            <field name="domain_force">[('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <!-- Branch Manager: see all -->
        <record id="library_loan_branch_manager_rule" model="ir.rule">
            <field name="name">Library Loan: branch manager sees all</field>
            <field name="model_id" ref="model_library_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
        <record id="library_loan_line_branch_manager_rule" model="ir.rule">
            <field name="name">Library Loan Line: branch manager sees all</field>
            <field name="model_id" ref="model_library_loan_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
        <record id="library_fine_branch_manager_rule" model="ir.rule">
            <field name="name">Library Fine: branch manager sees all</field>
            <field name="model_id" ref="model_library_fine"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
