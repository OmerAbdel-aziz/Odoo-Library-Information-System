<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_floor_view_form_map" model="ir.ui.view">
        <field name="name">library.floor.form.map</field>
        <field name="model">library.floor</field>
        <field name="inherit_id" ref="library_base.library_floor_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Indoor Map">
                    <group>
                        <button name="action_view_indoor_map" type="object" string="Open Indoor Map" class="oe_highlight"/>
                        <field name="plan_svg" filename="plan_filename"/>
                        <field name="plan_filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="shelf_count_mapped" string="Mapped Shelves"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
