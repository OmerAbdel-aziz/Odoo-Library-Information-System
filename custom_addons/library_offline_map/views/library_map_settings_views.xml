<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_map_settings_view_list" model="ir.ui.view">
        <field name="name">library.map.settings.list</field>
        <field name="model">library.map.settings</field>
        <field name="arch" type="xml">
            <list string="Map Settings">
                <field name="name"/>
                <field name="tiles_url" optional="show"/>
            </list>
        </field>
    </record>

    <record id="library_map_settings_view_form" model="ir.ui.view">
        <field name="name">library.map.settings.form</field>
        <field name="model">library.map.settings</field>
        <field name="arch" type="xml">
            <form string="Map Settings">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group string="Offline Services">
                        <group>
                            <field name="tiles_url"/>
                            <field name="style_url"/>
                            <field name="maplibre_js_url"/>
                            <field name="maplibre_css_url"/>
                        </group>
                        <group>
                            <field name="nominatim_url"/>
                            <field name="valhalla_url"/>
                        </group>
                    </group>
                    <group string="Connectivity">
                        <button name="action_test_tiles" type="object" string="Test Tiles"/>
                        <button name="action_test_nominatim" type="object" string="Test Nominatim"/>
                        <button name="action_test_valhalla" type="object" string="Test Valhalla"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_map_settings_action" model="ir.actions.act_window">
        <field name="name">Map Settings</field>
        <field name="res_model">library.map.settings</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
