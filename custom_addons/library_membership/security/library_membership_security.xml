<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rules -->
        <record id="library_member_company_rule" model="ir.rule">
            <field name="name">Library Member: multi-company</field>
            <field name="model_id" ref="model_library_member"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- User-level rules: branch visibility -->
        <record id="library_member_user_rule" model="ir.rule">
            <field name="name">Library Member: assigned branches</field>
            <field name="model_id" ref="model_library_member"/>
            <field name="domain_force">[('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <!-- Branch Manager rules: see all -->
        <record id="library_member_branch_manager_rule" model="ir.rule">
            <field name="name">Library Member: branch manager sees all</field>
            <field name="model_id" ref="model_library_member"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>

        <!-- Membership Plan: global (no branch restriction) -->
        <record id="library_membership_plan_user_rule" model="ir.rule">
            <field name="name">Library Membership Plan: all users</field>
            <field name="model_id" ref="model_library_membership_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>
    </data>
</odoo>
