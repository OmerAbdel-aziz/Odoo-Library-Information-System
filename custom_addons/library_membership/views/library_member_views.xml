<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_member_view_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Members" multi_edit="1">
                <field name="member_number"/>
                <field name="partner_id"/>
                <field name="member_type"/>
                <field name="membership_plan_id"/>
                <field name="branch_id" optional="show"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status in ('draft', 'suspended')" decoration-danger="status in ('blocked', 'cancelled')"/>
                <field name="expiry_date" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_member_view_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Library Member">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="status not in ('draft', 'suspended', 'blocked')"/>
                    <button name="action_suspend" type="object" string="Suspend" invisible="status != 'active'"/>
                    <button name="action_block" type="object" string="Block" invisible="status not in ('active', 'suspended')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status == 'cancelled'"/>
                    <button name="action_set_draft" type="object" string="Set to Draft" invisible="status != 'cancelled'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="partner_id"/>
                        <h1><field name="partner_id" placeholder="Select a contact"/></h1>
                    </div>
                    <group>
                        <group string="Membership">
                            <field name="active" invisible="1"/>
                            <field name="member_number"/>
                            <field name="barcode"/>
                            <field name="membership_plan_id"/>
                            <field name="member_type"/>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Dates">
                            <field name="registration_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="Limits">
                        <group>
                            <field name="max_books"/>
                            <field name="current_loans_count"/>
                            <field name="outstanding_fines"/>
                        </group>
                        <group>
                            <field name="blocked"/>
                            <field name="block_reason" invisible="not blocked"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_member_view_search" model="ir.ui.view">
        <field name="name">library.member.search</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <search string="Members">
                <field name="member_number"/>
                <field name="partner_id"/>
                <field name="barcode"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Draft" name="status_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Active Members" name="status_active" domain="[('status', '=', 'active')]"/>
                <filter string="Expired" name="status_expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Suspended" name="status_suspended" domain="[('status', '=', 'suspended')]"/>
                <filter string="Blocked" name="status_blocked" domain="[('status', '=', 'blocked')]"/>
                <group>
                    <filter name="group_by_type" string="Member Type" context="{'group_by': 'member_type'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_plan" string="Plan" context="{'group_by': 'membership_plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_member_action" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a new member</p>
            <p>Add library members with their membership plans and details.</p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="library_member_menu" name="Members" parent="library_base.library_menu_operations" action="library_member_action" sequence="40" groups="library_base.library_group_user"/>

    <menuitem id="library_membership_config_menu" name="Membership" parent="library_base.library_menu_configuration" sequence="30" groups="library_base.library_group_branch_manager"/>
    <menuitem id="library_membership_plan_menu" name="Membership Plans" parent="library_membership_config_menu" action="library_membership_plan_action" sequence="10"/>
</odoo>
