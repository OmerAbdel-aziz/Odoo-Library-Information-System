<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="library_transfer_company_rule" model="ir.rule">
            <field name="name">Library Transfer: multi-company</field>
            <field name="model_id" ref="model_library_transfer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="library_transfer_user_rule" model="ir.rule">
            <field name="name">Library Transfer: assigned branches</field>
            <field name="model_id" ref="model_library_transfer"/>
            <field name="domain_force">['|', ('source_branch_id', 'in', user.allowed_branch_ids.ids), ('dest_branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <record id="library_transfer_branch_manager_rule" model="ir.rule">
            <field name="name">Library Transfer: branch manager sees all</field>
            <field name="model_id" ref="model_library_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
