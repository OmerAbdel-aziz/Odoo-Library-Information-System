<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_serial_issue_view_list" model="ir.ui.view">
        <field name="name">library.serial.issue.list</field>
        <field name="model">library.serial.issue</field>
        <field name="arch" type="xml">
            <list string="Serial Issues" multi_edit="1">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="label"/>
                <field name="expected_date"/>
                <field name="received_date" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'received'" decoration-warning="state in ('missing', 'claimed')" decoration-info="state == 'expected'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_serial_issue_view_form" model="ir.ui.view">
        <field name="name">library.serial.issue.form</field>
        <field name="model">library.serial.issue</field>
        <field name="arch" type="xml">
            <form string="Serial Issue">
                <header>
                    <button name="action_receive" type="object" string="Receive" class="oe_highlight" invisible="state not in ('expected', 'claimed')"/>
                    <button name="action_mark_missing" type="object" string="Mark Missing" invisible="state != 'expected'"/>
                    <button name="action_claim" type="object" string="Claim" invisible="state != 'missing'"/>
                    <field name="state" widget="statusbar" statusbar_visible="expected,received,missing,claimed" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="label"/>
                        <h1><field name="label" placeholder="e.g. 2026-09"/></h1>
                    </div>
                    <group>
                        <group string="Issue">
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="subscription_id"/>
                            <field name="branch_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Tracking">
                            <field name="expected_date" readonly="state != 'expected'"/>
                            <field name="received_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_serial_issue_view_search" model="ir.ui.view">
        <field name="name">library.serial.issue.search</field>
        <field name="model">library.serial.issue</field>
        <field name="arch" type="xml">
            <search string="Serial Issues">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="label"/>
                <separator/>
                <filter name="expected" string="Expected" domain="[('state', '=', 'expected')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>
                <filter name="missing" string="Missing" domain="[('state', '=', 'missing')]"/>
                <filter name="claimed" string="Claimed" domain="[('state', '=', 'claimed')]"/>
                <group>
                    <filter name="group_by_subscription" string="Subscription" context="{'group_by': 'subscription_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_serial_issue_action" model="ir.actions.act_window">
        <field name="name">Serial Issues</field>
        <field name="res_model">library.serial.issue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_expected': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No issues expected</p>
            <p>Generate expected issues from a subscription.</p>
        </field>
    </record>

    <menuitem id="library_serials_menu" name="Serials" parent="library_base.library_menu_operations" sequence="45" groups="library_base.library_group_librarian"/>
    <menuitem id="library_subscription_menu" name="Subscriptions" parent="library_serials_menu" action="library_subscription_action" sequence="10"/>
    <menuitem id="library_serial_issue_menu" name="Issues" parent="library_serials_menu" action="library_serial_issue_action" sequence="20"/>
</odoo>
