<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="library_subscription_company_rule" model="ir.rule">
            <field name="name">Library Subscription: multi-company</field>
            <field name="model_id" ref="model_library_subscription"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="library_serial_issue_company_rule" model="ir.rule">
            <field name="name">Library Serial Issue: multi-company</field>
            <field name="model_id" ref="model_library_serial_issue"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="library_subscription_user_rule" model="ir.rule">
            <field name="name">Library Subscription: assigned branches</field>
            <field name="model_id" ref="model_library_subscription"/>
            <field name="domain_force">['|', ('branch_id', 'in', user.allowed_branch_ids.ids), ('branch_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>
        <record id="library_serial_issue_user_rule" model="ir.rule">
            <field name="name">Library Serial Issue: assigned branches</field>
            <field name="model_id" ref="model_library_serial_issue"/>
            <field name="domain_force">['|', ('branch_id', 'in', user.allowed_branch_ids.ids), ('branch_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <record id="library_subscription_branch_manager_rule" model="ir.rule">
            <field name="name">Library Subscription: branch manager sees all</field>
            <field name="model_id" ref="model_library_subscription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
        <record id="library_serial_issue_branch_manager_rule" model="ir.rule">
            <field name="name">Library Serial Issue: branch manager sees all</field>
            <field name="model_id" ref="model_library_serial_issue"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
