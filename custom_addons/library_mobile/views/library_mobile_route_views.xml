<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_mobile_route_view_list" model="ir.ui.view">
        <field name="name">library.mobile.route.list</field>
        <field name="model">library.mobile.route</field>
        <field name="arch" type="xml">
            <list string="Mobile Routes">
                <field name="name"/>
                <field name="title"/>
                <field name="unit_id"/>
                <field name="branch_id" optional="show"/>
                <field name="stop_count" string="Stops"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_mobile_route_view_form" model="ir.ui.view">
        <field name="name">library.mobile.route.form</field>
        <field name="model">library.mobile.route</field>
        <field name="arch" type="xml">
            <form string="Mobile Route">
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Saturday Route"/></h1>
                    </div>
                    <group>
                        <group string="Route">
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="unit_id"/>
                            <field name="branch_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <list string="Stops" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="address" optional="show"/>
                                    <field name="latitude" optional="hide"/>
                                    <field name="longitude" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_mobile_route_view_search" model="ir.ui.view">
        <field name="name">library.mobile.route.search</field>
        <field name="model">library.mobile.route</field>
        <field name="arch" type="xml">
            <search string="Mobile Routes">
                <field name="name"/>
                <field name="title"/>
                <field name="unit_id"/>
            </search>
        </field>
    </record>

    <record id="library_mobile_route_action" model="ir.actions.act_window">
        <field name="name">Mobile Routes</field>
        <field name="res_model">library.mobile.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
