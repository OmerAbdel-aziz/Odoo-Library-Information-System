<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_mobile_unit_view_list" model="ir.ui.view">
        <field name="name">library.mobile.unit.list</field>
        <field name="model">library.mobile.unit</field>
        <field name="arch" type="xml">
            <list string="Mobile Units">
                <field name="name"/>
                <field name="title"/>
                <field name="vehicle_number" optional="show"/>
                <field name="home_branch_id"/>
                <field name="capacity"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_mobile_unit_view_form" model="ir.ui.view">
        <field name="name">library.mobile.unit.form</field>
        <field name="model">library.mobile.unit</field>
        <field name="arch" type="xml">
            <form string="Mobile Unit">
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Mobile Library #1"/></h1>
                    </div>
                    <group>
                        <group string="Unit">
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="vehicle_number"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Assignment">
                            <field name="home_branch_id"/>
                            <field name="driver_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_mobile_unit_view_search" model="ir.ui.view">
        <field name="name">library.mobile.unit.search</field>
        <field name="model">library.mobile.unit</field>
        <field name="arch" type="xml">
            <search string="Mobile Units">
                <field name="name"/>
                <field name="title"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="library_mobile_unit_action" model="ir.actions.act_window">
        <field name="name">Mobile Units</field>
        <field name="res_model">library.mobile.unit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
