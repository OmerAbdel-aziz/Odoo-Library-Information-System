<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="library_member_portal_rule" model="ir.rule">
            <field name="name">Library Member: portal sees own record</field>
            <field name="model_id" ref="library_membership.model_library_member"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="library_loan_portal_rule" model="ir.rule">
            <field name="name">Library Loan: portal sees own loans</field>
            <field name="model_id" ref="library_circulation.model_library_loan"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="library_loan_line_portal_rule" model="ir.rule">
            <field name="name">Library Loan Line: portal sees own lines</field>
            <field name="model_id" ref="library_circulation.model_library_loan_line"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="library_fine_portal_rule" model="ir.rule">
            <field name="name">Library Fine: portal sees own fines</field>
            <field name="model_id" ref="library_circulation.model_library_fine"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="library_reservation_portal_rule" model="ir.rule">
            <field name="name">Library Reservation: portal sees own reservations</field>
            <field name="model_id" ref="library_reservation.model_library_reservation"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="library_event_registration_portal_rule" model="ir.rule">
            <field name="name">Library Event Registration: portal sees own registrations</field>
            <field name="model_id" ref="library_events.model_library_event_registration"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        <record id="ir_sequence_portal_rule" model="ir.rule">
            <field name="name">Sequences: portal may use library sequences</field>
            <field name="model_id" ref="base.model_ir_sequence"/>
            <field name="domain_force">[('code', 'in', ('library.reservation', 'library.event.registration'))]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
