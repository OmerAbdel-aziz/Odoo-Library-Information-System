<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_reservation_view_list" model="ir.ui.view">
        <field name="name">library.reservation.list</field>
        <field name="model">library.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations" multi_edit="1">
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="preferred_branch_id" optional="show"/>
                <field name="request_date"/>
                <field name="queue_position" string="Queue #"/>
                <field name="expiry_date" optional="show"/>
                <field name="state" widget="badge" decoration-success="state in ('ready_for_pickup', 'collected')" decoration-info="state == 'waiting'" decoration-warning="state == 'allocated'" decoration-muted="state in ('expired', 'cancelled')"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_reservation_view_form" model="ir.ui.view">
        <field name="name">library.reservation.form</field>
        <field name="model">library.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_allocate" type="object" string="Allocate Copy" class="oe_highlight" invisible="state != 'waiting'"/>
                    <button name="action_ready_for_pickup" type="object" string="Mark Ready" class="oe_highlight" invisible="state != 'allocated'"/>
                    <button name="action_collect" type="object" string="Collect" class="oe_highlight" invisible="state not in ('allocated', 'ready_for_pickup')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('collected', 'cancelled', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,allocated,ready_for_pickup,collected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Reservation Details">
                            <field name="active" invisible="1"/>
                            <field name="member_id"/>
                            <field name="book_id"/>
                            <field name="preferred_branch_id"/>
                            <field name="copy_id" invisible="state == 'waiting'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Dates &amp; Queue">
                            <field name="request_date"/>
                            <field name="queue_position" string="Queue Position"/>
                            <field name="hold_days"/>
                            <field name="ready_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_reservation_view_search" model="ir.ui.view">
        <field name="name">library.reservation.search</field>
        <field name="model">library.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservations">
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <separator/>
                <filter name="waiting" string="Waiting" domain="[('state', '=', 'waiting')]"/>
                <filter name="allocated" string="Allocated" domain="[('state', '=', 'allocated')]"/>
                <filter name="ready" string="Ready for Pickup" domain="[('state', '=', 'ready_for_pickup')]"/>
                <filter name="collected" string="Collected" domain="[('state', '=', 'collected')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <group>
                    <filter name="group_by_book" string="Book" context="{'group_by': 'book_id'}"/>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'preferred_branch_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_reservation_action" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">library.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_waiting': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new reservation</p>
            <p>Reserve books for members when copies are not available.</p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="library_reservation_menu" name="Reservations" parent="library_base.library_menu_operations" action="library_reservation_action" sequence="25" groups="library_base.library_group_circulation"/>
</odoo>
