<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rules -->
        <record id="library_reservation_company_rule" model="ir.rule">
            <field name="name">Library Reservation: multi-company</field>
            <field name="model_id" ref="model_library_reservation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- User rules: branch visibility -->
        <record id="library_reservation_user_rule" model="ir.rule">
            <field name="name">Library Reservation: assigned branches</field>
            <field name="model_id" ref="model_library_reservation"/>
            <field name="domain_force">[('preferred_branch_id', 'in', user.allowed_branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <!-- Branch Manager: see all -->
        <record id="library_reservation_branch_manager_rule" model="ir.rule">
            <field name="name">Library Reservation: branch manager sees all</field>
            <field name="model_id" ref="model_library_reservation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
