<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_event_view_list" model="ir.ui.view">
        <field name="name">library.event.list</field>
        <field name="model">library.event</field>
        <field name="arch" type="xml">
            <list string="Events" multi_edit="1">
                <field name="name"/>
                <field name="title"/>
                <field name="event_type" widget="badge"/>
                <field name="branch_id" optional="show"/>
                <field name="start_datetime"/>
                <field name="registration_count" string="Registered"/>
                <field name="seats_left" string="Seats Left"/>
                <field name="state" widget="badge" decoration-success="state in ('published', 'ongoing')" decoration-muted="state in ('done', 'cancelled')"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_event_view_form" model="ir.ui.view">
        <field name="name">library.event.form</field>
        <field name="model">library.event</field>
        <field name="arch" type="xml">
            <form string="Event">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" class="oe_highlight" invisible="state != 'published'"/>
                    <button name="action_finish" type="object" string="Finish" class="oe_highlight" invisible="state != 'ongoing'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,ongoing,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_registrations" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="registration_count" widget="statinfo" string="Registered"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Summer Reading Club"/></h1>
                    </div>
                    <group>
                        <group string="Event">
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="event_type"/>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Schedule">
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="capacity"/>
                            <field name="seats_left"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="About this event..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_event_view_search" model="ir.ui.view">
        <field name="name">library.event.search</field>
        <field name="model">library.event</field>
        <field name="arch" type="xml">
            <search string="Events">
                <field name="name"/>
                <field name="title"/>
                <separator/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_event_action" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">library.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an event</p>
            <p>Organize book clubs, workshops and readings.</p>
        </field>
    </record>
</odoo>
