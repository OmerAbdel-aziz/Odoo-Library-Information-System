<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_event_registration_view_list" model="ir.ui.view">
        <field name="name">library.event.registration.list</field>
        <field name="model">library.event.registration</field>
        <field name="arch" type="xml">
            <list string="Registrations" multi_edit="1">
                <field name="name"/>
                <field name="event_id"/>
                <field name="member_id"/>
                <field name="registration_date"/>
                <field name="state" widget="badge" decoration-success="state == 'attended'" decoration-info="state == 'registered'" decoration-muted="state == 'cancelled'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="library_event_registration_view_form" model="ir.ui.view">
        <field name="name">library.event.registration.form</field>
        <field name="model">library.event.registration</field>
        <field name="arch" type="xml">
            <form string="Registration">
                <header>
                    <button name="action_attend" type="object" string="Mark Attended" class="oe_highlight" invisible="state != 'registered'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="registered,attended,cancelled" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Registration">
                            <field name="active" invisible="1"/>
                            <field name="event_id"/>
                            <field name="member_id"/>
                            <field name="branch_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Tracking">
                            <field name="registration_date"/>
                            <field name="attended"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_event_registration_view_search" model="ir.ui.view">
        <field name="name">library.event.registration.search</field>
        <field name="model">library.event.registration</field>
        <field name="arch" type="xml">
            <search string="Registrations">
                <field name="name"/>
                <field name="event_id"/>
                <field name="member_id"/>
                <separator/>
                <filter name="registered" string="Registered" domain="[('state', '=', 'registered')]"/>
                <filter name="attended" string="Attended" domain="[('state', '=', 'attended')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <record id="library_event_registration_action" model="ir.actions.act_window">
        <field name="name">Registrations</field>
        <field name="res_model">library.event.registration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No registrations yet</p>
            <p>Members register for published events.</p>
        </field>
    </record>

    <menuitem id="library_events_menu" name="Events" parent="library_base.library_menu_operations" sequence="55" groups="library_base.library_group_librarian,library_base.library_group_circulation"/>
    <menuitem id="library_event_menu" name="Events" parent="library_events_menu" action="library_event_action" sequence="10"/>
    <menuitem id="library_event_registration_menu" name="Registrations" parent="library_events_menu" action="library_event_registration_action" sequence="20"/>
</odoo>
