<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="library_event_company_rule" model="ir.rule">
            <field name="name">Library Event: multi-company</field>
            <field name="model_id" ref="model_library_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="library_event_registration_company_rule" model="ir.rule">
            <field name="name">Library Event Registration: multi-company</field>
            <field name="model_id" ref="model_library_event_registration"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="library_event_user_rule" model="ir.rule">
            <field name="name">Library Event: assigned branches</field>
            <field name="model_id" ref="model_library_event"/>
            <field name="domain_force">['|', ('branch_id', 'in', user.allowed_branch_ids.ids), ('branch_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>
        <record id="library_event_registration_user_rule" model="ir.rule">
            <field name="name">Library Event Registration: assigned branches</field>
            <field name="model_id" ref="model_library_event_registration"/>
            <field name="domain_force">['|', ('branch_id', 'in', user.allowed_branch_ids.ids), ('branch_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_user'))]"/>
        </record>

        <record id="library_event_branch_manager_rule" model="ir.rule">
            <field name="name">Library Event: branch manager sees all</field>
            <field name="model_id" ref="model_library_event"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
        <record id="library_event_registration_branch_manager_rule" model="ir.rule">
            <field name="name">Library Event Registration: branch manager sees all</field>
            <field name="model_id" ref="model_library_event_registration"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('library_base.library_group_branch_manager'))]"/>
        </record>
    </data>
</odoo>
